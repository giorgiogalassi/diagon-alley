{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"books-store": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "projects/books-store",
			"sourceRoot": "projects/books-store/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "books-store:esbuild:production",
						"stylePreprocessorOptions": {
							"includePaths": [
								"projects/hp-library/src/lib/theme"
							]
						},
						"polyfills": []
					}
				},
				"serve": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "books-store:serve-original:development",
						"rebuildDelay": 0,
						"dev": true
					}
				},
				"extract-i18n": {
					"builder": "@angular-devkit/build-angular:extract-i18n",
					"options": {
						"buildTarget": "books-store:build"
					}
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/books-store/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							"projects/books-store/src/favicon.ico",
							"projects/books-store/src/assets"
						],
						"styles": [
							"projects/books-store/src/styles.scss"
						],
						"scripts": []
					}
				},
				"esbuild": {
					"builder": "@angular-devkit/build-angular:application",
					"options": {
						"outputPath": "dist/books-store",
						"index": "projects/books-store/src/index.html",
						"polyfills": [
							"zone.js",
							"es-module-shims"
						],
						"tsConfig": "projects/books-store/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							"projects/books-store/src/favicon.ico",
							"projects/books-store/src/assets"
						],
						"styles": [
							"projects/books-store/src/styles.scss"
						],
						"scripts": [],
						"browser": "projects/books-store/src/main.ts"
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kb",
									"maximumError": "1mb"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "2kb",
									"maximumError": "4kb"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true,
							"namedChunks": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve-original": {
					"builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 4201
          },
					"configurations": {
						"production": {
							"buildTarget": "books-store:esbuild:production"
						},
						"development": {
							"buildTarget": "books-store:esbuild:development"
						}
					},
					"defaultConfiguration": "development"
				}
			}
		},
